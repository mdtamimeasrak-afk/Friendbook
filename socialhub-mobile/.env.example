# Local environment variables (never commit this file - .env is gitignored).
#
# Only PUBLIC, publishable values belong here. The anon/publishable key is
# the safe client key that ships in the app; the service_role key and any
# FCM/Expo server credentials must NEVER be placed in this file or anywhere
# in the app bundle.
#
# Copy to .env and fill in your production Supabase project values:
#   EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side push secrets (NOT app variables!) - configured in the Supabase
# dashboard under Edge Functions -> Secrets, never in this repo:
#   SUPABASE_SERVICE_ROLE_KEY  - service role key (server only)
#   EXPO_ACCESS_TOKEN          - optional Expo Push API token
# Deploy the sender with:  supabase functions deploy notify --project-ref <ref>
# ---------------------------------------------------------------------------